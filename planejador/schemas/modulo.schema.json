{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Módulo paramétrico",
  "description": "Camada 2 da parametrização. Poucos parâmetros mestres (L, A, P, vãos, frentes) e peças derivadas por fórmula, estilo Inventor. Um módulo pode estender outro ('estende'): o arquivo vira um patch (JSON Merge Patch) sobre o módulo base, e null remove peça/vão/parâmetro herdado. O motor valida o módulo EFETIVO (após o merge) com as regras completas.",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "id": { "$ref": "comum.schema.json#/$defs/id" },
    "versao": { "$ref": "comum.schema.json#/$defs/versao" },
    "nome": { "type": "string" },
    "abstrato": {
      "type": "boolean",
      "description": "Módulo base que não aparece no catálogo (ex.: caixa de balcão). Só serve para ser estendido."
    },
    "estende": { "$ref": "comum.schema.json#/$defs/id" },
    "categoria": { "$ref": "comum.schema.json#/$defs/id" },
    "codigo": {
      "$ref": "comum.schema.json#/$defs/textoModelo",
      "description": "Código comercial/ERP. Ex.: \"BAL2P-{L}x{A}x{P}\"."
    },
    "descricao": { "$ref": "comum.schema.json#/$defs/textoModelo" },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "miniatura": { "type": "string" },
    "parametros": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/nome" }
    },
    "variaveis": {
      "type": "object",
      "description": "Variáveis derivadas (parâmetros de usuário do Inventor). Avaliadas por ordem de dependência; ciclo é erro de carga.",
      "propertyNames": { "$ref": "#/$defs/nome" },
      "additionalProperties": {
        "anyOf": [
          { "$ref": "comum.schema.json#/$defs/expressao" },
          { "type": "null" }
        ]
      }
    },
    "restricoes": {
      "type": "object",
      "description": "Restrições indexadas por id (herdáveis e removíveis com null).",
      "propertyNames": { "$ref": "comum.schema.json#/$defs/id" },
      "additionalProperties": {
        "anyOf": [
          { "$ref": "#/$defs/restricao" },
          { "type": "null" }
        ]
      }
    },
    "sobrescrever": {
      "type": "object",
      "description": "Patch do padrão efetivo só para este módulo (ex.: folga diferente numa porta de canto)."
    },
    "pecas": {
      "type": "object",
      "propertyNames": { "$ref": "comum.schema.json#/$defs/id" }
    },
    "vaos": {
      "type": "object",
      "propertyNames": { "$ref": "comum.schema.json#/$defs/id" }
    },
    "regras": {
      "$ref": "comum.schema.json#/$defs/mapaRegras",
      "description": "Regras aplicadas ao módulo inteiro, depois de peças e vãos (ex.: canal de costa, junções)."
    },
    "ferragens": {
      "type": "object",
      "description": "Ferragens fixas do módulo (as geradas por regra não precisam constar aqui).",
      "additionalProperties": {
        "anyOf": [
          { "$ref": "#/$defs/ferragemFixa" },
          { "type": "null" }
        ]
      }
    },
    "modelos3d": {
      "type": "object",
      "description": "Geometria importada (glTF) que NÃO é chapa: puxadores, pés, perfis, acessórios. Chapa é sempre gerada pelo motor, nunca esticada a partir de malha.",
      "additionalProperties": {
        "anyOf": [
          { "$ref": "#/$defs/componente3d" },
          { "type": "null" }
        ]
      }
    }
  },
  "required": ["id", "versao", "nome"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "abstrato": { "const": true }
        },
        "required": ["abstrato"]
      },
      "then": {},
      "else": {
        "required": ["categoria"]
      }
    },
    {
      "if": {
        "required": ["estende"]
      },
      "then": {
        "properties": {
          "parametros": {
            "additionalProperties": {
              "anyOf": [
                { "$ref": "#/$defs/parametroParcial" },
                { "type": "null" }
              ]
            }
          },
          "pecas": {
            "additionalProperties": {
              "anyOf": [
                { "$ref": "#/$defs/pecaParcial" },
                { "type": "null" }
              ]
            }
          },
          "vaos": {
            "additionalProperties": {
              "anyOf": [
                { "$ref": "#/$defs/vaoParcial" },
                { "type": "null" }
              ]
            }
          }
        }
      },
      "else": {
        "required": ["parametros", "pecas"],
        "properties": {
          "parametros": {
            "additionalProperties": { "$ref": "#/$defs/parametro" }
          },
          "pecas": {
            "additionalProperties": { "$ref": "#/$defs/peca" }
          },
          "vaos": {
            "additionalProperties": { "$ref": "#/$defs/vao" }
          }
        }
      }
    }
  ],
  "$defs": {
    "nome": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "description": "Nome usável dentro de expressões."
    },
    "parametroParcial": {
      "type": "object",
      "properties": {
        "rotulo": { "type": "string" },
        "descricao": { "type": "string" },
        "tipo": {
          "enum": ["medida", "inteiro", "numero", "booleano", "opcao", "acabamento", "ferragem"]
        },
        "padrao": {
          "type": ["number", "string", "boolean"],
          "description": "Se ausente, vem de parametrosPadrao da categoria, depois da linha."
        },
        "eixo": {
          "$ref": "comum.schema.json#/$defs/eixo",
          "description": "Liga a medida mestre a um eixo: o planejador 3D mostra alça de esticar nesse eixo."
        },
        "modo": {
          "enum": ["livre", "fixo", "passos", "lista"],
          "description": "Comportamento do eixo/parâmetro: livre (min..max), fixo (só o padrão), passos (min..max com incremento), lista (valores)."
        },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "incremento": { "type": "number", "exclusiveMinimum": 0 },
        "valores": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 1
        },
        "opcoes": {
          "type": "object",
          "description": "Para tipo 'opcao': valor -> rótulo.",
          "additionalProperties": { "type": "string" }
        },
        "categoria": { "type": "string", "description": "Para tipo 'ferragem': categoria permitida (ex.: puxador)." },
        "grupo": { "type": "string", "description": "Agrupamento no painel de propriedades." },
        "visivel": {
          "$ref": "comum.schema.json#/$defs/expressao",
          "description": "Só mostra o parâmetro quando a expressão é verdadeira."
        },
        "editavelNoProjeto": { "type": "boolean", "description": "false = só o cadastrador altera; o vendedor não vê." }
      },
      "additionalProperties": false
    },
    "parametro": {
      "allOf": [
        { "$ref": "#/$defs/parametroParcial" },
        {
          "required": ["rotulo", "tipo"]
        },
        {
          "if": {
            "properties": {
              "modo": { "const": "passos" }
            },
            "required": ["modo"]
          },
          "then": {
            "required": ["min", "max", "incremento"]
          }
        },
        {
          "if": {
            "properties": {
              "modo": { "const": "lista" }
            },
            "required": ["modo"]
          },
          "then": {
            "required": ["valores"]
          }
        },
        {
          "if": {
            "properties": {
              "tipo": { "const": "opcao" }
            },
            "required": ["tipo"]
          },
          "then": {
            "required": ["opcoes"]
          }
        }
      ]
    },
    "pecaParcial": {
      "type": "object",
      "description": "Peça de chapa: uma caixa retangular. comprimento/largura são medidas FINAIS (com fita); a medida de corte é derivada pelo motor conforme regrasFita.",
      "properties": {
        "papel": { "type": "string", "description": "Chave de 'papeis' do padrão de fábrica." },
        "nome": {
          "$ref": "comum.schema.json#/$defs/textoModelo",
          "description": "Descrição na lista de corte. Padrão: rótulo do papel."
        },
        "eixos": { "$ref": "comum.schema.json#/$defs/eixosPeca" },
        "comprimento": { "$ref": "comum.schema.json#/$defs/expressao" },
        "largura": { "$ref": "comum.schema.json#/$defs/expressao" },
        "espessura": {
          "$ref": "comum.schema.json#/$defs/expressao",
          "description": "Padrão: espessura do material do acabamento."
        },
        "posicao": {
          "$ref": "comum.schema.json#/$defs/ponto3",
          "description": "Canto mínimo (menor x, y, z) da peça no sistema do módulo."
        },
        "acabamento": { "type": "string", "description": "Slot de acabamento. Padrão: o do papel." },
        "material": {
          "$ref": "comum.schema.json#/$defs/id",
          "description": "Força um material específico (ignora o acabamento)."
        },
        "fitas": { "$ref": "comum.schema.json#/$defs/listaFaces", "description": "Padrão: as fitas do papel." },
        "fita": {
          "$ref": "comum.schema.json#/$defs/id",
          "description": "Força uma fita específica. Padrão: fita do material."
        },
        "condicao": { "$ref": "comum.schema.json#/$defs/expressao", "description": "A peça só existe se for verdadeira." },
        "repetir": {
          "type": "object",
          "description": "Gera N instâncias. Dentro das expressões da peça: i = índice (0..n-1), n = quantidade.",
          "properties": {
            "quantidade": { "$ref": "comum.schema.json#/$defs/expressao" }
          },
          "required": ["quantidade"],
          "additionalProperties": false
        },
        "usinagens": {
          "type": "array",
          "items": { "$ref": "comum.schema.json#/$defs/usinagem" }
        },
        "obs": { "type": "string" }
      },
      "additionalProperties": false
    },
    "peca": {
      "allOf": [
        { "$ref": "#/$defs/pecaParcial" },
        {
          "required": ["papel", "eixos", "comprimento", "largura", "posicao"]
        }
      ]
    },
    "caixaVao": {
      "type": "object",
      "description": "Volume livre do vão (luz interna), no sistema do módulo.",
      "properties": {
        "x": { "$ref": "comum.schema.json#/$defs/expressao" },
        "y": { "$ref": "comum.schema.json#/$defs/expressao" },
        "z": { "$ref": "comum.schema.json#/$defs/expressao" },
        "L": { "$ref": "comum.schema.json#/$defs/expressao" },
        "A": { "$ref": "comum.schema.json#/$defs/expressao" },
        "P": { "$ref": "comum.schema.json#/$defs/expressao" }
      },
      "required": ["x", "y", "z", "L", "A", "P"],
      "additionalProperties": false
    },
    "bordasVao": {
      "type": "object",
      "description": "Peça que delimita cada face do vão. Regras de frente usam isso para calcular sobreposição (peça externa x separador interno). Em sub-vãos, o motor preenche com os separadores.",
      "propertyNames": { "$ref": "comum.schema.json#/$defs/face" },
      "additionalProperties": { "$ref": "comum.schema.json#/$defs/id" }
    },
    "divisao": {
      "type": "object",
      "description": "Divide o vão em partes ao longo de um eixo, da coordenada menor para a maior (y: de baixo para cima).",
      "properties": {
        "eixo": { "$ref": "comum.schema.json#/$defs/eixo" },
        "referencia": {
          "enum": ["vao", "frente"],
          "description": "vao: 'tamanho' é a luz interna de cada parte. frente: 'tamanho' é a altura/largura da FRENTE acabada; o motor posiciona cada separador no eixo da fresta entre frentes (a grade de frentes manda, a caixa obedece)."
        },
        "separador": {
          "description": "Peça criada entre as partes (travessa, divisória). null = sem separador.",
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "papel": { "type": "string" },
                "acabamento": { "type": "string" },
                "fitas": { "$ref": "comum.schema.json#/$defs/listaFaces" },
                "recuoFrontal": { "$ref": "comum.schema.json#/$defs/expressao" },
                "profundidade": {
                  "$ref": "comum.schema.json#/$defs/expressao",
                  "description": "Padrão: profundidade do vão (menos recuoFrontal)."
                }
              },
              "required": ["papel"],
              "additionalProperties": false
            },
            { "type": "null" }
          ]
        },
        "partes": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/parte" }
        }
      },
      "required": ["eixo", "partes"],
      "additionalProperties": false
    },
    "parte": {
      "type": "object",
      "properties": {
        "id": { "$ref": "comum.schema.json#/$defs/id" },
        "tamanho": {
          "description": "Expressão em mm, '40%' do total, ou '*' / '2*' para dividir o restante por peso.",
          "anyOf": [
            { "$ref": "comum.schema.json#/$defs/expressao" },
            { "type": "string", "pattern": "^(\\d+(\\.\\d+)?)?\\*$" },
            { "type": "string", "pattern": "^\\d+(\\.\\d+)?%$" }
          ]
        },
        "dividir": { "$ref": "#/$defs/divisao" },
        "regras": { "$ref": "comum.schema.json#/$defs/mapaRegras" }
      },
      "required": ["id", "tamanho"],
      "additionalProperties": false
    },
    "vaoParcial": {
      "type": "object",
      "properties": {
        "caixa": { "$ref": "#/$defs/caixaVao" },
        "bordas": { "$ref": "#/$defs/bordasVao" },
        "dividir": { "$ref": "#/$defs/divisao" },
        "regras": { "$ref": "comum.schema.json#/$defs/mapaRegras" }
      },
      "additionalProperties": false
    },
    "vao": {
      "allOf": [
        { "$ref": "#/$defs/vaoParcial" },
        {
          "required": ["caixa"]
        }
      ]
    },
    "restricao": {
      "type": "object",
      "properties": {
        "quando": {
          "$ref": "comum.schema.json#/$defs/expressao",
          "description": "Dispara o alerta quando a expressão é verdadeira."
        },
        "nivel": {
          "enum": ["erro", "aviso"],
          "description": "erro bloqueia o envio para produção; aviso só sinaliza."
        },
        "mensagem": { "$ref": "comum.schema.json#/$defs/textoModelo" }
      },
      "required": ["quando", "nivel", "mensagem"],
      "additionalProperties": false
    },
    "ferragemFixa": {
      "type": "object",
      "properties": {
        "ferragem": { "$ref": "comum.schema.json#/$defs/id" },
        "quantidade": { "$ref": "comum.schema.json#/$defs/expressao" },
        "condicao": { "$ref": "comum.schema.json#/$defs/expressao" }
      },
      "required": ["ferragem", "quantidade"],
      "additionalProperties": false
    },
    "comportamentoEixo": {
      "type": "object",
      "description": "Como a geometria importada reage à mudança dos parâmetros neste eixo.",
      "properties": {
        "modo": {
          "enum": ["fixo", "esticar", "repetir"],
          "description": "fixo: mantém o tamanho original. esticar: escala até 'tamanho'. repetir: instancia 'quantidade' cópias distribuídas de 'de' até 'ate' (ou a cada 'passo')."
        },
        "ancora": {
          "enum": ["min", "centro", "max"],
          "description": "Ponto da caixa da malha que fica preso em 'em' (ancorar)."
        },
        "em": {
          "$ref": "comum.schema.json#/$defs/expressao",
          "description": "Coordenada do módulo onde a âncora fica."
        },
        "tamanho": { "$ref": "comum.schema.json#/$defs/expressao" },
        "quantidade": { "$ref": "comum.schema.json#/$defs/expressao" },
        "de": { "$ref": "comum.schema.json#/$defs/expressao" },
        "ate": { "$ref": "comum.schema.json#/$defs/expressao" },
        "passo": { "$ref": "comum.schema.json#/$defs/expressao" },
        "protegerBordas": {
          "type": "array",
          "items": { "type": "number", "minimum": 0 },
          "minItems": 2,
          "maxItems": 2,
          "description": "mm protegidos em cada ponta ao esticar (ponteiras de perfil não deformam)."
        }
      },
      "required": ["modo"],
      "additionalProperties": false
    },
    "componente3d": {
      "type": "object",
      "properties": {
        "fonte": {
          "type": "object",
          "properties": {
            "arquivo": { "type": "string", "description": "glb relativo a catalogo/." },
            "no": {
              "type": "string",
              "description": "Nó do glTF: extras.planejador.id (estável) ou, na falta, o nome."
            }
          },
          "required": ["arquivo"],
          "additionalProperties": false
        },
        "papel": { "type": "string", "description": "puxador, pe, perfil, acessorio, eletro..." },
        "ferragem": {
          "$ref": "comum.schema.json#/$defs/id",
          "description": "Item de ferragem contado na lista (1 por instância)."
        },
        "condicao": { "$ref": "comum.schema.json#/$defs/expressao" },
        "eixos": {
          "type": "object",
          "properties": {
            "x": { "$ref": "#/$defs/comportamentoEixo" },
            "y": { "$ref": "#/$defs/comportamentoEixo" },
            "z": { "$ref": "#/$defs/comportamentoEixo" }
          },
          "required": ["x", "y", "z"],
          "additionalProperties": false
        }
      },
      "required": ["fonte", "eixos"],
      "additionalProperties": false
    }
  }
}
