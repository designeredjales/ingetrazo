{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Biblioteca de regras moveleiras (manifestos)",
  "description": "Camada 3 da parametrização. Cada regra é uma função TypeScript pura no motor (packages/engine/src/regras) acompanhada deste manifesto. O manifesto é o contrato: o parametrizador visual monta a UI de argumentos a partir dele, e o motor checa no carregamento se o padrão efetivo tem tudo que a regra declara ler. Divisão de responsabilidade: CÓDIGO = comportamento (como dividir, onde furar); PADRÃO DE FÁBRICA = números e tabelas (quanto de folga, quantas dobradiças).",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "versao": { "$ref": "comum.schema.json#/$defs/versao" },
    "regras": {
      "type": "object",
      "propertyNames": { "$ref": "comum.schema.json#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/manifestoRegra" }
    },
    "funcoes": {
      "type": "object",
      "description": "Funções disponíveis dentro de expressões (autocompletar do editor de fórmulas).",
      "additionalProperties": { "$ref": "#/$defs/manifestoFuncao" }
    }
  },
  "required": ["versao", "regras", "funcoes"],
  "additionalProperties": false,

  "$defs": {
    "argumento": {
      "type": "object",
      "properties": {
        "tipo": { "enum": ["medida", "inteiro", "numero", "booleano", "opcao", "lista", "ferragem", "faces", "peca", "expressao"] },
        "rotulo": { "type": "string" },
        "descricao": { "type": "string" },
        "padrao": {},
        "obrigatorio": { "type": "boolean" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "opcoes": { "type": "object", "additionalProperties": { "type": "string" } },
        "categoria": { "type": "string", "description": "Para tipo ferragem: categoria aceita. 'auto' delega a escolha à regra." },
        "itens": { "type": "string", "description": "Para tipo lista: tipo de cada item." }
      },
      "required": ["tipo", "rotulo"],
      "additionalProperties": false
    },
    "manifestoRegra": {
      "type": "object",
      "properties": {
        "nome": { "type": "string" },
        "descricao": { "type": "string" },
        "versao": { "$ref": "comum.schema.json#/$defs/versao" },
        "estado": { "enum": ["planejada", "prototipo", "estavel", "obsoleta"] },
        "marco": { "type": "string", "description": "Marco de entrega (v0 = protótipo de viabilidade)." },
        "aplicaEm": {
          "enum": ["modulo", "vao", "peca"],
          "description": "Contexto recebido: módulo inteiro, um vão (caixa + bordas) ou uma peça resolvida."
        },
        "argumentos": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/argumento" }
        },
        "le": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Caminhos do padrão efetivo que a regra usa (ex.: folgas.frentes.entreFrentes). O motor recusa o catálogo se algum faltar — erro na carga, não na fábrica."
        },
        "produz": {
          "type": "object",
          "properties": {
            "pecas": { "type": "array", "items": { "type": "string" }, "description": "Papéis das peças criadas." },
            "ferragens": { "type": "array", "items": { "type": "string" }, "description": "Categorias de ferragem adicionadas." },
            "usinagens": { "type": "boolean" },
            "componentes3d": { "type": "array", "items": { "type": "string" } },
            "retorno": { "type": "string", "description": "Para regras-função: o que devolvem a quem chamou." }
          },
          "additionalProperties": false
        },
        "chama": {
          "type": "array",
          "items": { "$ref": "comum.schema.json#/$defs/id" },
          "description": "Outras regras que esta compõe."
        },
        "alertas": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Situações que a regra sinaliza (ex.: corrediça não cabe)."
        }
      },
      "required": ["nome", "descricao", "versao", "estado", "aplicaEm", "argumentos", "le", "produz"],
      "additionalProperties": false
    },
    "manifestoFuncao": {
      "type": "object",
      "properties": {
        "assinatura": { "type": "string" },
        "descricao": { "type": "string" },
        "exemplo": { "type": "string" }
      },
      "required": ["assinatura", "descricao"],
      "additionalProperties": false
    }
  }
}
