{
  "$schema": "../../schemas/modulo.schema.json",
  "id": "cz.gaveteiro",
  "versao": "0.1.0",
  "nome": "Gaveteiro",
  "categoria": "cat.cozinha.balcoes",
  "estende": "base.caixa-balcao",
  "codigo": "GAV{nGavetas}-{L}x{A}x{P}",
  "descricao": "GAVETEIRO {nGavetas} GAVETAS {L}x{A}x{P}",
  "tags": ["cozinha", "balcao", "gavetas"],

  "parametros": {
    "L": { "padrao": 500, "max": 900 },
    "nGavetas": { "rotulo": "Gavetas", "tipo": "inteiro", "padrao": 3, "modo": "passos", "min": 2, "max": 5, "incremento": 1, "grupo": "Interno" },
    "divisao": {
      "rotulo": "Divisão das frentes",
      "tipo": "opcao",
      "opcoes": { "iguais": "Iguais", "progressiva": "Progressiva (maiores embaixo)" },
      "padrao": "iguais",
      "grupo": "Interno"
    },
    "puxador": { "rotulo": "Puxador", "tipo": "ferragem", "categoria": "puxador", "padrao": "PUX_160_PRETO", "grupo": "Acabamento" }
  },

  "restricoes": {
    "gavetaBaixa": {
      "quando": "(A - yBase) / nGavetas < fab.limites.gavetaFrenteMin",
      "nivel": "erro",
      "mensagem": "Com {nGavetas} gavetas as frentes ficam abaixo de {fab.limites.gavetaFrenteMin} mm."
    }
  },

  "vaos": {
    "interno": {
      "regras": {
        "gavetas": {
          "regra": "gavetas.dividir",
          "args": {
            "quantidade": "nGavetas",
            "modo": { "param": "divisao" },
            "fatorProgressao": 1.25,
            "tipoFrente": "sobreposta",
            "corredica": "auto",
            "puxador": { "param": "puxador" }
          }
        }
      }
    }
  }
}
